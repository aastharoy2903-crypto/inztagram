{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile record for a registered Inztagram user (no PII stored).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9._]{3,30}$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "bio": { "type": "string", "maxLength": 240 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "avatarPosition": { "type": "string", "maxLength": 40 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "bio", "avatarUrl", "followersCount", "followingCount", "postsCount", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Photo or short-video post referencing bundled local media assets.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "posterUrl": { "type": "string", "maxLength": 500 },
        "aspectRatio": { "type": "string", "enum": ["square", "portrait", "landscape"] },
        "caption": { "type": "string", "maxLength": 1000 },
        "altText": { "type": "string", "maxLength": 300 },
        "hashtags": { "type": "array" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "mediaType", "mediaUrl", "caption", "altText", "hashtags", "likesCount", "commentsCount", "createdAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Single like record keyed by liking user UID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a post.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "text", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Directional follow relationship keyed by {followerId}_{followingId}.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "maxLength": 128 },
        "followingId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles; owner-only write access."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "User posts referencing bundled local media assets."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "User likes on a post; keyed by user UID."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "User comments on a post."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Follow relationships between users."
    }
  }
}
