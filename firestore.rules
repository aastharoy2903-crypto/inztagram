rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Users collection: public readable profiles; only owner can create/update their profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isNonEmptyString(request.resource.data.username, 30)
        && request.resource.data.username.matches('^[a-z0-9._]{3,30}$')
        && isNonEmptyString(request.resource.data.displayName, 60)
        && isOptionalString(request.resource.data.bio, 240);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && isNonEmptyString(request.resource.data.username, 30)
        && request.resource.data.username.matches('^[a-z0-9._]{3,30}$')
        && isNonEmptyString(request.resource.data.displayName, 60)
        && isOptionalString(request.resource.data.bio, 240);
      allow delete: if false;
    }

    // Posts collection: signed-in users can read; only author can create/delete/edit caption & altText
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaType in ['image', 'video']
        && isNonEmptyString(request.resource.data.mediaUrl, 1000)
        && isOptionalString(request.resource.data.caption, 1000)
        && isOptionalString(request.resource.data.altText, 300)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && (
        // Author updating caption or altText
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && isOptionalString(request.resource.data.caption, 1000)
          && isOptionalString(request.resource.data.altText, 300))
        // Note: likesCount / commentsCount should ideally be maintained via Cloud Functions;
        // if updated client-side in a starter setup, restrict to single counter increments only:
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && request.resource.data.likesCount is int
            && request.resource.data.likesCount >= 0
            && (request.resource.data.likesCount == resource.data.likesCount + 1
                || request.resource.data.likesCount == resource.data.likesCount - 1))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
            && request.resource.data.commentsCount is int
            && request.resource.data.commentsCount >= 0
            && request.resource.data.commentsCount == resource.data.commentsCount + 1)
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Likes subcollection: document ID must equal the liking user's UID
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyString(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );
      }
    }

    // Follows collection: deterministic ID `{followerId}_{followingId}`
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Stories collection: 24-hour expiring items
    match /stories/{storyId} {
      allow read: if isSignedIn() && resource.data.expiresAt > request.time;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaType in ['image', 'video']
        && isNonEmptyString(request.resource.data.mediaUrl, 1000)
        && isOptionalString(request.resource.data.caption, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Direct Message conversations & messages: participant-only access
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && isNonEmptyString(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
      }
    }

    // In-app notifications: recipient-only read & mark-as-read; actor creates on interaction
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type in ['like', 'comment', 'follow', 'message']
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Safety: reports & blocks (private to creating user)
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'user']
        && isNonEmptyString(request.resource.data.reason, 200)
        && request.resource.data.createdAt == request.time;
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId
        && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
    }
  }
}
