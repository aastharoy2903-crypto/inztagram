rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isSafeMediaRef(val) {
      return val is string
        && val.size() > 0
        && val.size() <= 500
        && (val.matches('^/assets/.*') || val.matches('^https://.*'));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'displayName',
          'bio',
          'avatarUrl',
          'followersCount',
          'followingCount',
          'postsCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'displayName',
          'bio',
          'avatarUrl',
          'avatarPosition',
          'followersCount',
          'followingCount',
          'postsCount',
          'createdAt'
        ])
        && data.uid == userId
        && isNonEmptyString(data.username, 30)
        && data.username.matches('^[a-z0-9._]{3,30}$')
        && isNonEmptyString(data.displayName, 60)
        && data.displayName.size() >= 2
        && isOptionalString(data.bio, 240)
        && isSafeMediaRef(data.avatarUrl)
        && (!('avatarPosition' in data) || isOptionalString(data.avatarPosition, 40))
        && data.followersCount is int && data.followersCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.postsCount is int && data.postsCount >= 0
        && data.createdAt is timestamp;
    }

    function isValidHashtagList(tags) {
      return tags is list
        && tags.size() <= 20
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() <= 50));
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId',
          'mediaType',
          'mediaUrl',
          'caption',
          'altText',
          'hashtags',
          'likesCount',
          'commentsCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'authorId',
          'mediaType',
          'mediaUrl',
          'posterUrl',
          'aspectRatio',
          'objectPosition',
          'caption',
          'altText',
          'hashtags',
          'likesCount',
          'commentsCount',
          'createdAt'
        ])
        && data.authorId is string
        && data.mediaType in ['image', 'video']
        && isSafeMediaRef(data.mediaUrl)
        && (!('posterUrl' in data) || data.posterUrl == null || isSafeMediaRef(data.posterUrl))
        && (!('aspectRatio' in data) || data.aspectRatio in ['square', 'portrait', 'landscape'])
        && (!('objectPosition' in data) || isOptionalString(data.objectPosition, 40))
        && isOptionalString(data.caption, 1000)
        && isOptionalString(data.altText, 300)
        && isValidHashtagList(data.hashtags)
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.createdAt is timestamp;
    }

    // Users collection: public display profiles (no PII); owner-only create/update
    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().postsCount == 0
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().followersCount == existing().followersCount
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username',
          'displayName',
          'bio',
          'avatarUrl',
          'avatarPosition',
          'followingCount',
          'postsCount'
        ]);
      allow delete: if false;
    }

    // Posts collection: signed-in users can read; owner-only edit/delete; atomic like/comment count sync
    match /posts/{postId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(postId);
      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          // Author editing caption, altText, or hashtags only
          (existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'altText', 'hashtags']))
          // Atomic +1 like synced with likes/{uid} creation
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
              && incoming().likesCount == existing().likesCount + 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
          // Atomic -1 unlike synced with likes/{uid} deletion
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
              && incoming().likesCount == existing().likesCount - 1
              && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
          // Comment count increment (+1)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
              && incoming().commentsCount == existing().commentsCount + 1)
        );
      allow delete: if isSignedIn()
        && isValidId(postId)
        && existing().authorId == request.auth.uid;

      // Likes subcollection: document ID must equal the liking user's UID
      match /likes/{userId} {
        allow list: if isSignedIn();
        allow get: if isSignedIn() && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(postId)
          && isValidId(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && incoming().keys().hasAll(['userId', 'createdAt'])
          && incoming().keys().hasOnly(['userId', 'createdAt'])
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(postId) && isValidId(userId);
      }

      // Comments subcollection: signed-in users can read & add comments; comment author or post owner can delete
      match /comments/{commentId} {
        allow list: if isSignedIn();
        allow get: if isSignedIn() && isValidId(commentId);
        allow create: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && incoming().keys().hasAll(['authorId', 'text', 'createdAt'])
          && incoming().keys().hasOnly(['authorId', 'text', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && isNonEmptyString(incoming().text, 500)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          );
      }
    }

    // Follows collection: deterministic ID `{followerId}_{followingId}`
    match /follows/{followId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(followId);
      allow create: if isSignedIn()
        && isValidId(followId)
        && incoming().keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && incoming().keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && incoming().followerId == request.auth.uid
        && incoming().followingId is string
        && isValidId(incoming().followingId)
        && incoming().followingId != request.auth.uid
        && followId == request.auth.uid + '_' + incoming().followingId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(followId)
        && existing().followerId == request.auth.uid;
    }

    // Default deny for all other paths (Stories, DMs, Notifications, Reports/Blocks run locally in Demo Mode)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
